# ==============================================================================
# CALYX AUTH SERVICE: PRODUCTION MULTI-STAGE DOCKERFILE
# ==============================================================================
# Concept Explanation for Beginners:
# 1. Multi-Stage Builds:
#    In Stage 1 (builder), we install compilers and build wheels.
#    In Stage 2 (runner), we copy ONLY the compiled binaries into a slim Alpine/Debian
#    image. This keeps the final image tiny (< 180MB) and dramatically reduces attack surfaces!
#
# 2. Non-Root Security Context:
#    Never run containers as 'root'! If an attacker exploits a vulnerability in a root
#    container, they could break out to the host. We create an unprivileged user 'calyxuser'.
# ==============================================================================

# Stage 1: Build Dependencies
FROM python:3.12-slim AS builder

WORKDIR /build

# Install security updates
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.auth.txt ./requirements.txt
RUN pip install --no-cache-dir --default-timeout=1000 --retries=5 --user -r requirements.txt


# Stage 2: Production Minimal Runtime
FROM python:3.12-slim AS runner

WORKDIR /app

# Create unprivileged system group and user
RUN groupadd -r calyxgroup && useradd -r -g calyxgroup -u 10001 calyxuser

# Copy installed Python packages from builder stage
COPY --from=builder /root/.local /home/calyxuser/.local
ENV PATH=/home/calyxuser/.local/bin:$PATH
ENV PYTHONPATH=/app

# Copy shared kernel and auth service code
COPY common /app/common
COPY services/calyx_auth_service /app/services/calyx_auth_service

# Change ownership to non-root user
RUN chown -R calyxuser:calyxgroup /app

USER calyxuser

EXPOSE 8001

# Run Uvicorn ASGI server
CMD ["uvicorn", "services.calyx_auth_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
